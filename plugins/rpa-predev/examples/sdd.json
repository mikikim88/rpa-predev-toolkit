    "report": "결과 xlsx (성공 / 업무예외 / 시스템예외 시트) — 공유폴더 \\\\fs01\\정산\\결과"
  },
  "notifications": [
    {"trigger": "처리 완료", "recipient": "재무팀장, 정산 담당", "channel": "메일", "content": "처리 요약 + 결과 xlsx"},
    {"trigger": "승인 필요", "recipient": "정산 담당", "channel": "메일", "content": "차이 내역, 승인/반려 버튼"},
    {"trigger": "시스템 장애", "recipient": "RPA 운영팀", "channel": "메일 + 메신저", "content": "오류 메시지, 스크린샷"}
  ],
