  "security": [
    {"item": "봇 계정", "measure": "봇 전용 SAP 계정, FB60·FK03 최소 권한, 비밀번호 90일 자동 갱신"},
    {"item": "민감정보", "measure": "로그·스크린샷에서 계좌번호 마스킹, 결과 파일 접근권한 재무팀 한정"},
